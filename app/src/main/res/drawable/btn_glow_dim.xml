<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-4dp" android:bottom="-4dp" android:left="-4dp" android:right="-4dp">
        <shape android:shape="rectangle">
            <stroke android:width="5dp" android:color="#1F8C0327" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/matte_black_lighter" />
            <stroke
                android:width="1dp"
                android:color="@color/wine_red_dim" />
            <corners android:radius="14dp" />
            <padding
                android:left="24dp"
                android:right="24dp"
                android:top="16dp"
                android:bottom="16dp" />
        </shape>
    </item>
</layer-list>
