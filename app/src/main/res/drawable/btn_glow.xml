<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outermost, faintest glow ring -->
    <item android:top="-8dp" android:bottom="-8dp" android:left="-8dp" android:right="-8dp">
        <shape android:shape="rectangle">
            <stroke android:width="8dp" android:color="#148C0327" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- mid glow ring -->
    <item android:top="-4dp" android:bottom="-4dp" android:left="-4dp" android:right="-4dp">
        <shape android:shape="rectangle">
            <stroke android:width="6dp" android:color="#308C0327" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- core button -->
    <item android:drawable="@drawable/btn_core" />
</layer-list>
