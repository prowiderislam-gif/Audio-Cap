<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_bg"
    android:padding="10dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/bubbleDragHandle"
        android:layout_width="44dp"
        android:layout_height="18dp"
        android:gravity="center"
        android:text="⋯"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:rotation="90" />

    <TextView
        android:id="@+id/bubbleTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/bubbleRecordButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bubble_button_bg"
        android:gravity="center"
        android:text="●"
        android:textColor="@color/wine_red_glow"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/bubblePauseButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bubble_button_bg_dim"
        android:gravity="center"
        android:text="❙❙"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bubbleCloseButton"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
